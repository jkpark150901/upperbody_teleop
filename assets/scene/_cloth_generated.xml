    <contact selfcollide="auto" passive="true" solref="0.01 1.0" solimp="0.95 0.99 0.0001"
        friction="1.2 0.01 0.0001"/>
    <elasticity young="2.0e4" poisson="0.2" thickness="0.001"
        elastic2d="both" damping="0.02"/>
  </flexcomp>
</mujocoinclude>
