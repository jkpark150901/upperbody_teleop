    <exclude name="exclude_table_right_hand_rl_dg_2_1" body1="table" body2="right_hand_rl_dg_2_1"/>
    <exclude name="exclude_table_right_hand_rl_dg_2_2" body1="table" body2="right_hand_rl_dg_2_2"/>
    <exclude name="exclude_table_right_hand_rl_dg_2_3" body1="table" body2="right_hand_rl_dg_2_3"/>
    <exclude name="exclude_table_right_hand_rl_dg_2_4" body1="table" body2="right_hand_rl_dg_2_4"/>
    <exclude name="exclude_table_right_hand_rl_dg_3_1" body1="table" body2="right_hand_rl_dg_3_1"/>
    <exclude name="exclude_table_right_hand_rl_dg_3_2" body1="table" body2="right_hand_rl_dg_3_2"/>
    <exclude name="exclude_table_right_hand_rl_dg_3_3" body1="table" body2="right_hand_rl_dg_3_3"/>
    <exclude name="exclude_table_right_hand_rl_dg_3_4" body1="table" body2="right_hand_rl_dg_3_4"/>
    <exclude name="exclude_table_right_hand_rl_dg_3_tip" body1="table" body2="right_hand_rl_dg_3_tip"/>
