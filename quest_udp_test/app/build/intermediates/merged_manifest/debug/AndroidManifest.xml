<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.upperbodyteleop.questudptest"
    android:versionCode="1"
    android:versionName="1.0" >

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="32" />
    <!--
       Plain UDP socket usage; no VR/immersive features declared on purpose
       so this launches as a normal 2D panel on Quest, sidestepping the
       OpenXR session / Guardian / focus complexity XrHandsFB has been
       running into (see Meta-OpenXR-SDK/.../XrHandsFB/Src/main.cpp).
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:label="Quest UDP Test" >
        <activity
            android:name="com.upperbodyteleop.questudptest.MainActivity"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>